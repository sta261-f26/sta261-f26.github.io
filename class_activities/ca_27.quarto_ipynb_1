    "#| include: false\n",
    "\n",
    "import numpy as np\n",
    "\n",
    "socks = np.concat((np.arange(1, 11), np.arange(1, 11)))\n",
    "nsim = 10000\n",
    "res = np.zeros(nsim)\n",
    "\n",
    "for i in range(nsim):\n",
    "  shuffled_socks = np.random.choice(socks, 20, replace=False)\n",
    "  left_socks = shuffled_socks[np.arange(1, 21, 2)]\n",
    "  right_socks = shuffled_socks[np.arange(0, 20, 2)]\n",
    "  res[i] = max(abs(left_socks - right_socks))\n",
    "  \n",
    "np.mean(res <= 3)"
   ]
